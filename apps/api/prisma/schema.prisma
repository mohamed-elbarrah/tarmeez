generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MERCHANT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  VIEWER
}

enum EmailOtpPurpose {
  SIGNUP_VERIFICATION
  PASSWORD_RESET
}

model User {
  id              String              @id @default(uuid())
  email           String              @unique
  name            String
  passwordHash    String              @map("password_hash")
  role            UserRole            @default(MERCHANT)
  status          UserStatus          @default(ACTIVE)
  emailVerifiedAt DateTime?           @map("email_verified_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  membership      MerchantMembership?
  ownedMerchant   Merchant?           @relation("MerchantOwner")
  emailOtps       EmailOtp[]
  refreshTokens   RefreshToken[]
  sentInvitations Invitation[]        @relation("InvitationInviter")

  @@map("users")
}

model Merchant {
  id                     String                  @id @default(uuid())
  ownerUserId            String                  @unique @map("owner_user_id")
  name                   String
  status                 MerchantStatus          @default(ACTIVE)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  owner                  User                    @relation("MerchantOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  memberships            MerchantMembership[]
  invitations            Invitation[]
  connections            StoreConnection[]
  sallaConnectionIntents SallaConnectionIntent[]

  @@map("merchants")
}

model MerchantMembership {
  id         String         @id @default(uuid())
  userId     String         @unique @map("user_id")
  merchantId String         @map("merchant_id")
  role       MembershipRole @default(OWNER)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant   Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId])
  @@index([merchantId, role])
  @@map("merchant_memberships")
}

model Invitation {
  id              String         @id @default(uuid())
  merchantId      String         @map("merchant_id")
  invitedByUserId String         @map("invited_by_user_id")
  email           String         @unique
  role            MembershipRole @default(VIEWER)
  tokenHash       String         @unique @map("token_hash")
  expiresAt       DateTime       @map("expires_at")
  acceptedAt      DateTime?      @map("accepted_at")
  revokedAt       DateTime?      @map("revoked_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  merchant        Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  invitedBy       User           @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  emailOtps       EmailOtp[]

  @@index([merchantId, expiresAt])
  @@index([invitedByUserId])
  @@map("invitations")
}

model EmailOtp {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  invitationId String?         @map("invitation_id")
  purpose      EmailOtpPurpose
  codeHash     String          @map("code_hash")
  expiresAt    DateTime        @map("expires_at")
  attempts     Int             @default(0)
  lastSentAt   DateTime        @default(now()) @map("last_sent_at")
  consumedAt   DateTime?       @map("consumed_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation   Invitation?     @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@unique([userId, purpose])
  @@index([expiresAt])
  @@index([invitationId])
  @@map("email_otps")
}

enum StorePlatform {
  SALLA
}

enum StoreConnectionStatus {
  CONNECTED
  REAUTH_REQUIRED
  DISCONNECTED
}

model StoreConnection {
  id                    String                @id @default(uuid())
  merchantId            String                @map("merchant_id")
  platform              StorePlatform
  externalStoreId       String                @map("external_store_id")
  storeName             String?               @map("store_name")
  storeDomain           String?               @map("store_domain")
  status                StoreConnectionStatus @default(CONNECTED)
  accessTokenEncrypted  String                @map("access_token_encrypted")
  refreshTokenEncrypted String?               @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?             @map("token_expires_at")
  connectedAt           DateTime              @default(now()) @map("connected_at")
  verifiedAt            DateTime?             @map("verified_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  merchant              Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([platform, externalStoreId])
  @@index([merchantId, platform])
  @@map("store_connections")
}

model SallaConnectionIntent {
  id                  String    @id @default(uuid())
  merchantId          String    @map("merchant_id")
  expectedStoreDomain String    @map("expected_store_domain")
  expiresAt           DateTime  @map("expires_at")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  merchant            Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([expectedStoreDomain, expiresAt, completedAt])
  @@index([merchantId, createdAt])
  @@map("salla_connection_intents")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
