generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MERCHANT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  VIEWER
}

enum EmailOtpPurpose {
  SIGNUP_VERIFICATION
  PASSWORD_RESET
}

model User {
  id              String              @id @default(uuid())
  email           String              @unique
  name            String
  passwordHash    String              @map("password_hash")
  role            UserRole            @default(MERCHANT)
  status          UserStatus          @default(ACTIVE)
  emailVerifiedAt DateTime?           @map("email_verified_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  membership      MerchantMembership?
  ownedMerchant   Merchant?           @relation("MerchantOwner")
  emailOtps       EmailOtp[]
  refreshTokens   RefreshToken[]
  sentInvitations Invitation[]        @relation("InvitationInviter")

  @@map("users")
}

model Merchant {
  id                     String                  @id @default(uuid())
  ownerUserId            String                  @unique @map("owner_user_id")
  name                   String
  status                 MerchantStatus          @default(ACTIVE)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  owner                  User                    @relation("MerchantOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  memberships            MerchantMembership[]
  invitations            Invitation[]
  connections            StoreConnection[]
  sallaConnectionIntents SallaConnectionIntent[]
  commerceProducts       CommerceProduct[]
  commerceCustomers      CommerceCustomer[]
  commerceOrders         CommerceOrder[]

  @@map("merchants")
}

model MerchantMembership {
  id         String         @id @default(uuid())
  userId     String         @unique @map("user_id")
  merchantId String         @map("merchant_id")
  role       MembershipRole @default(OWNER)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant   Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId])
  @@index([merchantId, role])
  @@map("merchant_memberships")
}

model Invitation {
  id              String         @id @default(uuid())
  merchantId      String         @map("merchant_id")
  invitedByUserId String         @map("invited_by_user_id")
  email           String         @unique
  role            MembershipRole @default(VIEWER)
  tokenHash       String         @unique @map("token_hash")
  expiresAt       DateTime       @map("expires_at")
  acceptedAt      DateTime?      @map("accepted_at")
  revokedAt       DateTime?      @map("revoked_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  merchant        Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  invitedBy       User           @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  emailOtps       EmailOtp[]

  @@index([merchantId, expiresAt])
  @@index([invitedByUserId])
  @@map("invitations")
}

model EmailOtp {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  invitationId String?         @map("invitation_id")
  purpose      EmailOtpPurpose
  codeHash     String          @map("code_hash")
  expiresAt    DateTime        @map("expires_at")
  attempts     Int             @default(0)
  lastSentAt   DateTime        @default(now()) @map("last_sent_at")
  consumedAt   DateTime?       @map("consumed_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation   Invitation?     @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@unique([userId, purpose])
  @@index([expiresAt])
  @@index([invitationId])
  @@map("email_otps")
}

enum StorePlatform {
  SALLA
}

enum StoreConnectionStatus {
  CONNECTED
  REAUTH_REQUIRED
  DISCONNECTED
}

enum SyncResource {
  ALL
  PRODUCTS
  CUSTOMERS
  ORDERS
}

enum SyncRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

model StoreConnection {
  id                    String                @id @default(uuid())
  merchantId            String                @map("merchant_id")
  platform              StorePlatform
  externalStoreId       String                @map("external_store_id")
  storeName             String?               @map("store_name")
  storeDomain           String?               @map("store_domain")
  status                StoreConnectionStatus @default(CONNECTED)
  accessTokenEncrypted  String                @map("access_token_encrypted")
  refreshTokenEncrypted String?               @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?             @map("token_expires_at")
  refreshLockToken      String?               @map("refresh_lock_token")
  refreshLockExpiresAt  DateTime?             @map("refresh_lock_expires_at")
  connectedAt           DateTime              @default(now()) @map("connected_at")
  verifiedAt            DateTime?             @map("verified_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  merchant              Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products              CommerceProduct[]
  customers             CommerceCustomer[]
  orders                CommerceOrder[]
  syncRuns              SyncRun[]

  @@unique([platform, externalStoreId])
  @@index([merchantId, platform])
  @@map("store_connections")
}

model CommerceProduct {
  id              String              @id @default(uuid())
  merchantId      String              @map("merchant_id")
  connectionId    String              @map("connection_id")
  externalId      String              @map("external_id")
  name            String
  sku             String?
  description     String?
  productType     String?             @map("product_type")
  status          String?
  currency        String?
  price           Decimal?            @db.Decimal(18, 4)
  salePrice       Decimal?            @map("sale_price") @db.Decimal(18, 4)
  quantity        Int?
  isAvailable     Boolean?            @map("is_available")
  sourceCreatedAt DateTime?           @map("source_created_at")
  sourceUpdatedAt DateTime?           @map("source_updated_at")
  sourceData      Json?               @map("source_data")
  lastSyncedAt    DateTime            @default(now()) @map("last_synced_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  merchant        Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  connection      StoreConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  orderItems      CommerceOrderItem[]

  @@unique([connectionId, externalId])
  @@index([merchantId, sourceUpdatedAt])
  @@index([connectionId, status])
  @@map("commerce_products")
}

model CommerceCustomer {
  id              String          @id @default(uuid())
  merchantId      String          @map("merchant_id")
  connectionId    String          @map("connection_id")
  externalId      String          @map("external_id")
  name            String?
  email           String?
  phone           String?
  city            String?
  country         String?
  sourceCreatedAt DateTime?       @map("source_created_at")
  sourceUpdatedAt DateTime?       @map("source_updated_at")
  sourceData      Json?           @map("source_data")
  lastSyncedAt    DateTime        @default(now()) @map("last_synced_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  merchant        Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  connection      StoreConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  orders          CommerceOrder[]

  @@unique([connectionId, externalId])
  @@index([merchantId, sourceUpdatedAt])
  @@map("commerce_customers")
}

model CommerceOrder {
  id              String              @id @default(uuid())
  merchantId      String              @map("merchant_id")
  connectionId    String              @map("connection_id")
  customerId      String?             @map("customer_id")
  externalId      String              @map("external_id")
  reference       String?
  status          String?
  currency        String?
  subtotal        Decimal?            @db.Decimal(18, 4)
  discountTotal   Decimal?            @map("discount_total") @db.Decimal(18, 4)
  shippingTotal   Decimal?            @map("shipping_total") @db.Decimal(18, 4)
  taxTotal        Decimal?            @map("tax_total") @db.Decimal(18, 4)
  total           Decimal?            @db.Decimal(18, 4)
  sourceCreatedAt DateTime?           @map("source_created_at")
  sourceUpdatedAt DateTime?           @map("source_updated_at")
  sourceData      Json?               @map("source_data")
  lastSyncedAt    DateTime            @default(now()) @map("last_synced_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  merchant        Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  connection      StoreConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  customer        CommerceCustomer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           CommerceOrderItem[]

  @@unique([connectionId, externalId])
  @@index([merchantId, sourceCreatedAt])
  @@index([connectionId, status])
  @@map("commerce_orders")
}

model CommerceOrderItem {
  id                String           @id @default(uuid())
  orderId           String           @map("order_id")
  productId         String?          @map("product_id")
  externalProductId String?          @map("external_product_id")
  externalVariantId String?          @map("external_variant_id")
  name              String?
  sku               String?
  quantity          Decimal?         @db.Decimal(18, 4)
  unitPrice         Decimal?         @map("unit_price") @db.Decimal(18, 4)
  total             Decimal?         @db.Decimal(18, 4)
  currency          String?
  sourceData        Json?            @map("source_data")
  order             CommerceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           CommerceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("commerce_order_items")
}

model SyncRun {
  id            String          @id @default(uuid())
  connectionId  String          @map("connection_id")
  resource      SyncResource
  status        SyncRunStatus   @default(QUEUED)
  cursor        String?
  fetchedCount  Int             @default(0) @map("fetched_count")
  upsertedCount Int             @default(0) @map("upserted_count")
  errorKey      String?         @map("error_key")
  errorMessage  String?         @map("error_message")
  startedAt     DateTime?       @map("started_at")
  finishedAt    DateTime?       @map("finished_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  connection    StoreConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@index([connectionId, resource, status])
  @@map("sync_runs")
}

model SallaConnectionIntent {
  id                  String    @id @default(uuid())
  merchantId          String    @map("merchant_id")
  expectedStoreDomain String    @map("expected_store_domain")
  expiresAt           DateTime  @map("expires_at")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  merchant            Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([expectedStoreDomain, expiresAt, completedAt])
  @@index([merchantId, createdAt])
  @@map("salla_connection_intents")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
