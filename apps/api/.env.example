# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database (local PostgreSQL)
DATABASE_URL=postgresql://tarmeez:secret@localhost:5432/tarmeez

# JWT — replace with long, random values before running the API
JWT_ACCESS_SECRET=replace-with-a-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=tarmeez-api
JWT_AUDIENCE=tarmeez-client

# Auth OTP policy — generate a random value of at least 32 characters
AUTH_OTP_PEPPER=replace-with-a-random-secret-of-at-least-32-characters
AUTH_OTP_EXPIRES_IN_MINUTES=10
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5

# Redis (local)
REDIS_HOST=localhost
REDIS_PORT=6379

# Email — local development: Mailpit SMTP (default port 1025; inbox UI usually 8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Tarmeez <no-reply@localhost>

# Integrations — fill these in when configuring provider apps
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_WEBHOOK_SECRET=
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
